# Copy to .env and fill in. .env is gitignored; this file is not.

# Local dev uses the compose service name; prod uses the Atlas connection string
# (injected from AWS Secrets Manager, never baked into the image).
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tracker

# Your personal key. The extension sends it as the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Who saved records belong to. Only matters once there's a second user.
USER_ID=me
